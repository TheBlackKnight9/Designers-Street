# ──────────────────────────────────────────────
# Designer's Street — Environment (placeholders)
# Copy to .env.local for Next.js / Prisma local use:
#   copy .env.example .env.local
# ──────────────────────────────────────────────

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Client façade switch (src/lib/api) — when true, callers fetch /api/*
# Keep false so existing pages behave identically (mock-data path).
NEXT_PUBLIC_USE_API=false

# Server switch for repositories/services behind Route Handlers
# false → services return mock-data (no DB required)
# true  → services use PostgreSQL via Prisma
USE_DATABASE=false

# PostgreSQL (Prisma) — required when USE_DATABASE=true
# Local docker-compose default:
DATABASE_URL=postgresql://designers:designers@localhost:5432/designers_street?schema=public

# Auth scaffold (Phase 2 will use these — do not commit real secrets)
AUTH_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=ds_session
SESSION_MAX_AGE_DAYS=14

# Optional media (Phase 3) — placeholders only
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
