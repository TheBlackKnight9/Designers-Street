# ──────────────────────────────────────────────
# Designer's Street — Environment (placeholders)
# Copy to .env / .env.local — never commit secrets
# ──────────────────────────────────────────────

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data source switches (keep false for mock-compatible UI)
# Production marketplace: set BOTH to true with a valid DATABASE_URL + Supabase
USE_DATABASE=false
NEXT_PUBLIC_USE_API=false

# Supabase PostgreSQL (Prisma) — Project Settings → Database → URI
DATABASE_URL=

# Supabase Auth / client (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Prefer publishable key; anon JWT also supported as fallback
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (images & videos) — Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
# Public cloud name for client-side f_auto / q_auto delivery (optional; falls back to CLOUDINARY_CLOUD_NAME at build if inlined)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Media upload limits (defaults: 10MB images, 100MB videos)
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=100
# Optional byte overrides (take precedence over MB if set)
# MEDIA_MAX_IMAGE_BYTES=10485760
# MEDIA_MAX_VIDEO_BYTES=104857600
# Per-product gallery caps
MEDIA_MAX_IMAGES_PER_PRODUCT=10
MEDIA_MAX_VIDEOS_PER_PRODUCT=3

# Public API rate limits (per IP, fixed window; products / feed / categories)
PUBLIC_API_RATE_LIMIT_MAX=120
PUBLIC_API_RATE_LIMIT_WINDOW_SEC=60
