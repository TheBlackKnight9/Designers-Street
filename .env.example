# ──────────────────────────────────────────────
# Designer's Street — Environment template
# Copy to .env.local (recommended) or .env — never commit secrets
# ──────────────────────────────────────────────

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data source switches
# false = mock catalog in UI; true = live DB + API routes (requires DATABASE_URL + Supabase)
USE_DATABASE=false
NEXT_PUBLIC_USE_API=false

# ── Supabase ──────────────────────────────────
# Project Settings → API (URL, anon/publishable, service_role)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma / PostgreSQL — Project Settings → Database
# Serverless / Vercel: use Supavisor pooler (port 6543) with pgbouncer=true
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# Direct connection (local migrations): port 5432, no pgbouncer param
DATABASE_URL=

# ── Cloudinary (product & feed media) ─────────
CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Media upload limits
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=100
# Optional byte overrides (take precedence over MB if set)
# MEDIA_MAX_IMAGE_BYTES=10485760
# MEDIA_MAX_VIDEO_BYTES=104857600
MEDIA_MAX_IMAGES_PER_PRODUCT=10
MEDIA_MAX_VIDEOS_PER_PRODUCT=3

# ── Razorpay (checkout & payouts) ─────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: dedicated webhook secret (falls back to RAZORPAY_KEY_SECRET)
RAZORPAY_WEBHOOK_SECRET=

# ── Email (Resend) ────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Designers Street <onboarding@resend.dev>

# ── SMS (MSG91) — optional ────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=DSLUXU
MSG91_FLOW_ORDER_PLACED=
MSG91_FLOW_ORDER_SHIPPED=
MSG91_FLOW_ORDER_DELIVERED=

# ── Auth session (custom cookie auth) ─────────
AUTH_SECRET=change-me-in-production
SESSION_COOKIE_NAME=ds_session
SESSION_MAX_AGE_DAYS=14

# ── Dev / QA overrides ────────────────────────
# TEST_NOTIFICATION_EMAIL=

# Public API rate limits (per IP, fixed window)
PUBLIC_API_RATE_LIMIT_MAX=120
PUBLIC_API_RATE_LIMIT_WINDOW_SEC=60
