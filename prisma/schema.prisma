  zone_a
  zone_b
  zone_c
  zone_d
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  size      String
  color     String?
  sku       String   @unique
  stock     Int      @default(0)
  price     Int?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size, color])
  @@index([productId])
  @@map("product_variants")
}

enum LeadSourceType {
  PRODUCT
  POST
  LOOKBOOK
  COLLECTION
}

model ConceptInterest {
  id          String   @id @default(cuid())
  sourceType  LeadSourceType @default(PRODUCT) @map("source_type")
  productId   String?  @map("product_id")
  postId      String?  @map("post_id")
  userId      String?  @map("user_id")
  name        String
  email       String
  phone       String?
  budgetRange      String?         @map("budget_range")
  notes            String?         @db.Text
  intent           CustomerIntent?
  consultationDate DateTime?       @map("consultation_date")
  status           LeadStatus      @default(NEW)
  createdAt        DateTime        @default(now()) @map("created_at")

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([postId])
  @@map("concept_interests")
}

model Review {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  productId    String    @map("product_id")
  orderId      String    @map("order_id")
  rating       Int
  title        String?
  body         String?   @db.Text
  images       String[]  @default([])
  isVerified   Boolean   @default(true) @map("is_verified")
  isApproved   Boolean   @default(true) @map("is_approved")
  helpfulCount Int       @default(0) @map("helpful_count")
  designerReply String?  @map("designer_reply") @db.Text
  repliedAt    DateTime? @map("replied_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, orderId])
  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model ShippingZone {
  id      String           @id @default(cuid())
  pincode String           @unique
  state   String
  zone    ShippingZoneType

  @@map("shipping_zones")
}

model ShippingRate {
  id            String           @id @default(cuid())
  designerId    String?          @map("designer_id")
  zone          ShippingZoneType
  weightSlabMin Int              @map("weight_slab_min")
  weightSlabMax Int              @map("weight_slab_max")
  price         Int

  @@unique([designerId, zone, weightSlabMin])
  @@map("shipping_rates")
}

enum CouponType {
  percentage
  fixed_amount
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  type           CouponType @default(fixed_amount)
  value          Int
  minOrderValue  Int        @default(0) @map("min_order_value")
  maxDiscount    Int?       @map("max_discount")
  usageLimit     Int?       @map("usage_limit")
  usedCount      Int        @default(0) @map("used_count")
  expiresAt      DateTime?  @map("expires_at")
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@map("coupons")
}



