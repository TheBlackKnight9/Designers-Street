// Designer's Street — Prisma schema
// Compatible with src/lib/types.ts (string IDs preserved for mock seed)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  buyer
  designer
  admin
}

enum AccountStatus {
  draft
  active
  suspended
}

enum ProductStatus {
  draft
  pending_review
  published
  archived
}

enum ProductGender {
  men
  women
  unisex
}

enum PostType {
  category
  designer_spotlight
}

enum MediaType {
  image
  video
}

enum MediaKind {
  image
  video
}

enum OrderStatus {
  pending
  paid
  processing
  shipped
  delivered
  cancelled
  cancelled_by_designer
  disputed
}

enum CustomizationStatus {
  draft
  submitted
  in_review
  quoted
  accepted
  rejected
  completed
  closed
}

enum AppointmentStatus {
  pending
  accepted
  rejected
  completed
  cancelled
}

enum LookbookKind {
  seasonal
  collection
  campaign
  editorial
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  name         String?
  role         UserRole @default(buyer)
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  designerHouse        DesignerHouse?
  likes                Like[]
  comments             Comment[]
  follows              Follow[]
  orders               Order[]
  customizationRequests CustomizationRequest[]
  mediaAssets          MediaAsset[]
  sessions             Session[]
  wishlistItems        WishlistItem[]
  addresses            Address[]
  cart                 Cart?
  notifications        Notification[]
  appointmentRequests  AppointmentRequest[]
  measurementProfiles  MeasurementProfile[]
  reviews              Review[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model DesignerHouse {
  id                    String        @id
  ownerUserId           String?       @unique @map("owner_user_id")
  name                  String
  handle                String        @unique
  logo                  String
  banner                String
  bio                   String
  foundingStory         String        @map("founding_story")
  founded               String?
  location              String
  signatureTechniques   String[]      @map("signature_techniques")
  verified              Boolean       @default(false)
  exclusive             Boolean       @default(false)
  offersBespoke         Boolean       @default(false) @map("offers_bespoke")
  followersCount        String?       @map("followers_count")
  followingCount        String?       @map("following_count")
  postsCount            Int?          @map("posts_count")
  website               String?
  designPhilosophy      String?       @map("design_philosophy")
  yearsExperience       Int?          @map("years_experience")
  studioLocation        String?       @map("studio_location")
  awards                String[]      @default([])
  pressMentions         Json?         @map("press_mentions")
  editorialGallery      String[]      @default([]) @map("editorial_gallery")
  socialLinks           Json?                 @map("social_links")
  returnAddressLine1    String?               @map("return_address_line1")
  returnAddressLine2    String?               @map("return_address_line2")
  returnCity            String?               @map("return_city")
  returnState           String?               @map("return_state")
  returnPincode         String?               @map("return_pincode")
  returnPhone           String?               @map("return_phone")
  accountStatus         AccountStatus         @default(active) @map("account_status")
  razorpayAccountId     String?               @map("razorpay_account_id")
  razorpayAccountStatus String?               @map("razorpay_account_status")
  listingsApproved      Boolean               @default(false) @map("listings_approved")
  // Phase 13: Admin-managed financials
  commissionRate        Float                 @default(10) @map("commission_rate")
  gstin                 String?
  pan                   String?
  bankBeneficiary       String?               @map("bank_beneficiary")
  bankAccount           String?               @map("bank_account")
  bankIfsc              String?               @map("bank_ifsc")
  bankName              String?               @map("bank_name")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  owner                 User?                 @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  products              Product[]
  posts                 Post[]
  stories               Story[]
  follows               Follow[]
  customizationRequests CustomizationRequest[]
  mediaAssets           MediaAsset[]
  lookbooks             Lookbook[]
  appointmentRequests   AppointmentRequest[]
  editorialCampaigns    EditorialCampaign[]
  editorialArticles     EditorialArticle[]
  appointmentSlots      AppointmentSlot[]
  businessVerification  BusinessVerification?
  orders                Order[]
  payouts               Payout[]

  @@map("designer_houses")
}

model Product {
  id               String        @id
  designerId       String        @map("designer_id")
  name             String
  designerName     String        @map("designer_name")
  price            Int
  basePrice        Int?          @map("base_price")
  mrp              Int?
  bestPrice        Int?          @map("best_price")
  category         String
  subcategory      String?
  gender           ProductGender
  images           String[]
  sizes            String[]
  colors           String[]      @default([])
  tags             String[]      @default([])
  description      String
  story            String?
  craftOrigin      String?       @map("craft_origin")
  material         String?
  technique        String?
  fit              String?
  occasion         String?
  verified         Boolean       @default(false)
  piecesRemaining  Int?          @map("pieces_remaining")
  limitedEdition   Boolean       @default(false) @map("limited_edition")
  editionTotal     Int?          @map("edition_total")
  editionSold      Int           @default(0) @map("edition_sold")
  customizable     Boolean       @default(false)
  rating           Float?
  deliveryText     String?       @map("delivery_text")
  careInstructions String?       @map("care_instructions")
  designerInspiration String?    @map("designer_inspiration")
  badges           String[]      @default([])
  editorsPick      Boolean       @default(false) @map("editors_pick")
  madeToOrder      Boolean       @default(false) @map("made_to_order")
  sustainable      Boolean       @default(false)
  handcrafted      Boolean       @default(false)
  recentPurchaseCount Int        @default(0) @map("recent_purchase_count")
  status           ProductStatus @default(published)
  likesCount       Int           @default(0) @map("likes_count")
  listingType          ProductListingType @default(COMMERCIAL) @map("listing_type")
  conceptCta           ConceptActionCTA?  @default(BESPOKE_INQUIRY) @map("concept_cta")
  estimatedLaunch      String?            @map("estimated_launch")
  weightGrams          Int?               @map("weight_grams")
  netQuantity          String?            @map("net_quantity")
  manufacturerName     String?            @map("manufacturer_name")
  manufacturerAddress  String?            @map("manufacturer_address")
  countryOfOrigin      String?            @default("India") @map("country_of_origin")
  sizeChart            Json?              @map("size_chart")
  aPlusContent         Json?              @map("a_plus_content")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at")

  designer               DesignerHouse           @relation(fields: [designerId], references: [id], onDelete: Cascade)
  orderItems             OrderItem[]
  customizationRequests  CustomizationRequest[]
  wishlistItems          WishlistItem[]
  mediaAssets            MediaAsset[]
  likes                  Like[]
  lookbookItems          LookbookItem[]
  editorialCollectionItems EditorialCollectionItem[]
  variants               ProductVariant[]
  conceptInterests       ConceptInterest[]
  reviews                Review[]

  @@index([designerId])
  @@index([category])
  @@index([status])
  @@index([limitedEdition])
  @@index([editorsPick])
  @@map("products")
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  image     String
  caption   String?
  parentId  String?  @map("parent_id")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryTree")

  @@index([parentId])
  @@map("categories")
}

model Post {
  id               String    @id
  type             PostType
  designerId       String?   @map("designer_id")
  designerName     String    @map("designer_name")
  designerLogo     String    @map("designer_logo")
  designerVerified Boolean   @default(false) @map("designer_verified")
  categorySlug     String?   @map("category_slug")
  tag              String?
  image            String
  videoUrl         String?   @map("video_url")
  mediaType        MediaType @default(image) @map("media_type")
  caption          String
  link             String
  likesCount       Int       @default(0) @map("likes_count")
  commentsCount    Int       @default(0) @map("comments_count")
  productTag       Json?     @map("product_tag")
  allowLeads       Boolean   @default(false) @map("allow_leads")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  designer DesignerHouse? @relation(fields: [designerId], references: [id], onDelete: SetNull)
  conceptInterests ConceptInterest[]
  likes    Like[]
  comments Comment[]
  mediaAssets MediaAsset[]

  @@index([designerId])
  @@index([createdAt])
  @@map("posts")
}

model Story {
  id         String    @id
  designerId String    @map("designer_id")
  label      String
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime? @map("expires_at")

  designer DesignerHouse @relation(fields: [designerId], references: [id], onDelete: Cascade)
  slides   StorySlide[]
  mediaAssets MediaAsset[]

  @@index([designerId])
  @@map("stories")
}

model StorySlide {
  id        String  @id @default(cuid())
  storyId   String  @map("story_id")
  position  Int     @default(0)
  image     String
  videoUrl  String? @map("video_url")
  caption   String?
  ctaLabel  String? @map("cta_label")
  ctaLink   String? @map("cta_link")

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId])
  @@map("story_slides")
}

enum MediaOwnerType {
  product
  post
  designer
  story
  unattached
}

model MediaAsset {
  id           String         @id @default(cuid())
  /// Optional FKs — attach media to catalog / feed / profile / stories without later schema churn
  productId    String?        @map("product_id")
  postId       String?        @map("post_id")
  designerId   String?        @map("designer_id")
  storyId      String?        @map("story_id")
  ownerType    MediaOwnerType @default(unattached) @map("owner_type")
  /// image | video (API field name: type)
  kind         MediaKind      @default(image)
  /// Cloudinary public_id (API: cloudinaryPublicId)
  publicId     String         @map("public_id")
  /// HTTPS delivery URL (API: secureUrl)
  url          String
  width        Int?
  height       Int?
  /// Duration in milliseconds for video (API: duration)
  durationMs   Int?           @map("duration_ms")
  format       String?
  bytes        Int?
  folder       String?
  /// Accessible caption / alt text (nullable)
  altText      String?        @map("alt_text")
  /// Preview frame URL (esp. videos); nullable for images
  thumbnailUrl String?        @map("thumbnail_url")
  /// Gallery / carousel order within an owner (multiple media per product/post)
  displayOrder Int            @default(0) @map("display_order")
  uploadedById String?        @map("uploaded_by")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  product    Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  post       Post?          @relation(fields: [postId], references: [id], onDelete: SetNull)
  designer   DesignerHouse? @relation(fields: [designerId], references: [id], onDelete: SetNull)
  story      Story?         @relation(fields: [storyId], references: [id], onDelete: SetNull)
  uploadedBy User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  /// Non-unique — many media rows per product/post/designer/story
  @@index([productId, displayOrder])
  @@index([postId, displayOrder])
  @@index([designerId, displayOrder])
  @@index([storyId, displayOrder])
  @@index([ownerType])
  @@index([kind])
  @@index([uploadedById])
  @@map("media_assets")
}

model Like {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  postId    String?  @map("post_id")
  productId String?  @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, productId])
  @@index([postId])
  @@index([productId])
  @@map("likes")
}

model Comment {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  body      String
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentThread")

  @@index([postId])
  @@index([parentId])
  @@index([userId])
  @@map("comments")
}

model Follow {
  id             String   @id @default(cuid())
  followerUserId String   @map("follower_user_id")
  designerId     String   @map("designer_id")
  createdAt      DateTime @default(now()) @map("created_at")

  follower User          @relation(fields: [followerUserId], references: [id], onDelete: Cascade)
  designer DesignerHouse @relation(fields: [designerId], references: [id], onDelete: Cascade)

  @@unique([followerUserId, designerId])
  @@map("follows")
}

model Order {
  id                  String        @id @default(cuid())
  userId              String        @map("user_id")
  parentPaymentId     String?       @map("parent_payment_id")
  designerId          String?       @map("designer_id")
  status              OrderStatus   @default(pending)
  subtotal            Int
  baseGarmentPrice    Int           @default(0) @map("base_garment_price")
  builtInShippingFee  Int           @default(0) @map("built_in_shipping_fee")
  platformCommission  Int           @default(0) @map("platform_commission")
  gstAmount           Int           @default(0) @map("gst_amount")
  prepaidDiscountShare Int          @default(0) @map("prepaid_discount_share")
  shippingFee         Int           @default(0) @map("shipping_fee")
  total               Int
  currency            String        @default("INR")
  commissionAmount    Int           @default(0) @map("commission_amount")
  commissionGst       Int           @default(0) @map("commission_gst")
  tcsDeducted         Int           @default(0) @map("tcs_deducted")
  designerNetEarnings Int           @default(0) @map("designer_net_earnings")
  designerNetPayable  Int           @default(0) @map("designer_net_payable")
  payoutId            String?       @map("payout_id")
  razorpayTransferId  String?       @map("razorpay_transfer_id")
  transferOnHoldUntil DateTime?     @map("transfer_on_hold_until")
  shippingAddress     Json?         @map("shipping_address")
  paymentStatus       String        @default("pending") @map("payment_status")
  courierName         String?       @map("courier_name")
  trackingNumber      String?       @map("tracking_number")
  trackingUrl         String?       @map("tracking_url")
  shippedAt           DateTime?     @map("shipped_at")
  expectedDelivery    DateTime?     @map("expected_delivery")
  deliveredAt         DateTime?     @map("delivered_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment  Payment?       @relation(fields: [parentPaymentId], references: [id], onDelete: SetNull)
  designer DesignerHouse? @relation(fields: [designerId], references: [id], onDelete: SetNull)
  payout   Payout?        @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  events   OrderEvent[]
  disputes OrderDispute[]
  reviews  Review[]

  @@index([userId])
  @@index([designerId])
  @@index([parentPaymentId])
  @@map("orders")
}

enum PaymentStatus {
  created
  authorized
  captured
  failed
  refunded
}

model Payment {
  id                String        @id @default(cuid())
  razorpayOrderId   String        @unique @map("razorpay_order_id")
  razorpayPaymentId String?       @unique @map("razorpay_payment_id")
  amount            Int
  discountApplied   Int           @default(10000) @map("discount_applied")
  currency          String        @default("INR")
  status            PaymentStatus @default(created)
  method            String?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at")

  orders Order[]

  @@map("payments")
}

enum DisputeStatus {
  open
  investigating
  resolved
}

model OrderDispute {
  id          String        @id @default(cuid())
  orderId     String        @map("order_id")
  buyerReason String        @map("buyer_reason")
  description String?
  status      DisputeStatus @default(open)
  adminNotes  String?       @map("admin_notes")
  resolution  String?
  resolvedBy  String?       @map("resolved_by")
  resolvedAt  DateTime?     @map("resolved_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_disputes")
}

enum PayoutStatus {
  pending
  processing
  completed
  failed
}

model Payout {
  id                  String        @id @default(cuid())
  designerId          String        @map("designer_id")
  payoutPeriodStart   DateTime      @map("payout_period_start")
  payoutPeriodEnd     DateTime      @map("payout_period_end")
  grossSales          Int           @map("gross_sales")
  totalCommission     Int           @map("total_commission")
  totalCommissionGst  Int           @map("total_commission_gst")
  totalTcsDeducted    Int           @map("total_tcs_deducted")
  netAmount           Int           @map("net_amount")
  status              PayoutStatus  @default(pending)
  method              String        @default("neft_manual")
  razorpayBatchId     String?       @map("razorpay_batch_id")
  bankUtrNumber       String?       @map("bank_utr_number")
  paidAt              DateTime?     @map("paid_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at")

  designer DesignerHouse @relation(fields: [designerId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([designerId])
  @@map("payouts")
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String  @map("order_id")
  productId        String? @map("product_id")
  name             String
  brand            String
  price            Int
  size             String
  image            String
  quantity         Int
  customizationJson Json?  @map("customization_json")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model CustomizationRequest {
  id                       String               @id @default(cuid())
  userId                   String?              @map("user_id")
  productId                String?              @map("product_id")
  designerId               String?              @map("designer_id")
  baseDesign               String?              @map("base_design")
  fabric                   String?
  color                    String?
  embellishment            String?
  size                     String?
  notes                    String?
  measurements             Json?
  referenceImages          String[]             @default([]) @map("reference_images")
  budget                   Int?
  occasion                 String?
  statusNotes              String?              @map("status_notes")
  measurementSessionBooked Boolean              @default(false) @map("measurement_session_booked")
  status                   CustomizationStatus  @default(draft)
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")

  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  product     Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  designer    DesignerHouse?      @relation(fields: [designerId], references: [id], onDelete: SetNull)
  attachments BespokeAttachment[]
  messages    BespokeMessage[]

  @@index([userId])
  @@index([designerId])
  @@index([status])
  @@map("customization_requests")
}

model Lookbook {
  id          String      @id @default(cuid())
  designerId  String      @map("designer_id")
  title       String
  slug        String
  kind        LookbookKind @default(seasonal)
  season      String?
  coverImage  String      @map("cover_image")
  description String?
  published   Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  designer DesignerHouse @relation(fields: [designerId], references: [id], onDelete: Cascade)
  items    LookbookItem[]

  @@unique([designerId, slug])
  @@index([designerId])
  @@index([published])
  @@map("lookbooks")
}

model LookbookItem {
  id           String    @id @default(cuid())
  lookbookId   String    @map("lookbook_id")
  mediaUrl     String    @map("media_url")
  mediaKind    MediaKind @default(image) @map("media_kind")
  caption      String?
  productId    String?   @map("product_id")
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")

  lookbook Lookbook @relation(fields: [lookbookId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([lookbookId])
  @@index([productId])
  @@map("lookbook_items")
}

model AppointmentRequest {
  id              String            @id @default(cuid())
  userId          String            @map("user_id")
  designerId      String            @map("designer_id")
  slotId          String?           @map("slot_id")
  preferredDate   String            @map("preferred_date")
  preferredTime   String            @map("preferred_time")
  appointmentType AppointmentType   @default(virtual) @map("appointment_type")
  purpose         String
  message         String?
  status          AppointmentStatus @default(pending)
  statusNotes     String?           @map("status_notes")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  designer DesignerHouse    @relation(fields: [designerId], references: [id], onDelete: Cascade)
  slot     AppointmentSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([designerId])
  @@index([status])
  @@map("appointment_requests")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

model Address {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  label      String?
  fullName   String   @map("full_name")
  phone      String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String   @map("postal_code")
  country    String   @default("IN")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Cart {
  id         String   @id @default(cuid())
  userId     String?  @unique @map("user_id")
  guestToken String?  @unique @map("guest_token")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  name      String
  brand     String
  price     Int
  size      String
  image     String
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, size])
  @@index([cartId])
  @@map("cart_items")
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_events")
}

model Notification {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  type         String
  title        String
  body         String
  orderId      String?   @map("order_id")
  postId       String?   @map("post_id")
  productId    String?   @map("product_id")
  designerId   String?   @map("designer_id")
  actorUserId  String?   @map("actor_user_id")
  readAt       DateTime? @map("read_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

enum SectionType {
  hero_campaign
  designer_spotlight
  editorial_collection
  article_rail
  lookbook_rail
  limited_edition_shelf
  editors_pick_shelf
}

model EditorialCampaign {
  id                 String   @id @default(cuid())
  title              String
  slug               String   @unique
  subtitle           String?
  heroImage          String   @map("hero_image")
  heroVideoUrl       String?  @map("hero_video_url")
  headline           String
  body               String
  badge              String?
  featuredDesignerId String?  @map("featured_designer_id")
  ctaLabel           String?  @map("cta_label")
  ctaLink            String?  @map("cta_link")
  published          Boolean  @default(true)
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  featuredDesigner DesignerHouse? @relation(fields: [featuredDesignerId], references: [id], onDelete: SetNull)

  @@index([published, sortOrder])
  @@map("editorial_campaigns")
}

model EditorialCollection {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  tagline      String?
  coverImage   String   @map("cover_image")
  description  String?
  curatorNotes String?  @map("curator_notes")
  published    Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  items EditorialCollectionItem[]

  @@index([published, sortOrder])
  @@map("editorial_collections")
}

model EditorialCollectionItem {
  id            String   @id @default(cuid())
  collectionId  String   @map("collection_id")
  productId     String   @map("product_id")
  displayOrder  Int      @default(0) @map("display_order")
  editorialNote String?  @map("editorial_note")
  createdAt     DateTime @default(now()) @map("created_at")

  collection EditorialCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([collectionId, displayOrder])
  @@map("editorial_collection_items")
}

model EditorialArticle {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String
  excerpt     String
  coverImage  String   @map("cover_image")
  contentJson Json     @map("content_json")
  authorName  String?  @map("author_name")
  authorRole  String?  @map("author_role")
  designerId  String?  @map("designer_id")
  published   Boolean  @default(true)
  publishedAt DateTime @default(now()) @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  designer DesignerHouse? @relation(fields: [designerId], references: [id], onDelete: SetNull)

  @@index([published, publishedAt])
  @@map("editorial_articles")
}

model FeaturedSection {
  id         String      @id @default(cuid())
  title      String
  subtitle   String?
  type       SectionType
  targetSlug String?     @map("target_slug")
  sortOrder  Int         @default(0) @map("sort_order")
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@index([active, sortOrder])
  @@map("featured_sections")
}

