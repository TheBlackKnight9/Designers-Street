}

model BespokeMessage {
  id         String   @id @default(cuid())
  requestId  String   @map("request_id")
  senderId   String   @map("sender_id")
  senderRole String   // "buyer" | "designer" | "system"
  message    String
  createdAt  DateTime @default(now()) @map("created_at")

